cat > .env.example <<'EOF'
# ===========================
# SecureAuth API Environment
# ===========================

# JWT secret MUST be at least 32 characters (HS256 requirement)
JWT_SECRET=change-me-super-secret-key-change-me-super-secret-key

# JWT settings (seconds)
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Optional issuer
JWT_ISSUER=secure-auth-api
EOF
